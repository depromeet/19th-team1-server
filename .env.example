# 로컬 개발용 환경변수 예시. 복사해서 .env 를 만들고 값을 채운다.
#   cp .env.example .env
# .env 는 git 에 올리지 않는다. 이 파일에는 이름과 예시 형식만 둔다.
#
# DB_PASSWORD 는 반드시 채운다. 로컬 PostgreSQL 이 처음 뜰 때 이 값으로 계정을 만든다.
#   - 각자 정하는 로컬 전용 값이다. 다른 곳에서 쓰는 비밀번호를 재사용하지 않는다.
#   - #, 공백, 따옴표는 쓰지 않는다 (Spring 과 Docker 가 다르게 해석한다).
#   - 나중에 바꾸려면 docker compose down -v 로 데이터를 지우고 다시 띄운다.

DB_NAME=team1
DB_USERNAME=team1
DB_PASSWORD=
DB_URL=jdbc:postgresql://localhost:5432/team1

# 카카오 로그인. 카카오 개발자 콘솔의 개발용 앱에서 REST API 키와 클라이언트 시크릿을 받아 넣는다.
# 리다이렉트 URI 는 콘솔에 등록한 값과 같아야 한다. 비어 있어도 local 은 뜨지만 로그인은 실패한다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# 액세스 토큰(JWT) 서명 키. Base64 로 32바이트 이상. 예: openssl rand -base64 32 의 출력을 넣는다.
# 비어 있으면 local 은 임시 키로 뜨고, 재시작하면 발급한 토큰이 모두 무효가 된다.
JWT_SECRET=

# 선택. 재발급에 쓴 리프레시 토큰이 다시 와도 탈취로 보지 않고 새 토큰 쌍을 주는 시간(기본 30s). 형식 예: 30s
# AUTH_REFRESH_TOKEN_REUSE_GRACE=

# 아래 값은 비밀이 아닌 로컬 기본값이다(application.yml, application-local.yml 과 같다). 값을 비우면 기본값 대신 빈 값이 들어가므로 지우지 않는다.
#
# 작업 큐. docker compose 의 ElasticMQ 를 가리킨다. 서버에서는 SQS_ENDPOINT 를 두지 않는다.
SQS_QUEUE_URL=http://localhost:9324/000000000000/team1-jobs
SQS_REGION=ap-southeast-2
SQS_ENDPOINT=http://localhost:9324

# 처리 작업·워커 설정. 기간은 ISO-8601(PT5M = 5분).
JOB_MAX_ATTEMPTS=3
JOB_VISIBILITY_TIMEOUT=PT5M
JOB_REPUBLISH_AFTER=PT10M
WORKER_ENABLED=true
WORKER_CONCURRENCY=4
SCHEDULER_ENABLED=true

# 서버 전용. 서버의 /srv/team1/.env 에만 둔다(deploy/compose.yaml 이 읽는다). 로컬 실행에는 필요 없다.
# 값은 docs/deployment.md 7절 표를 따른다.
APP_IMAGE_TAG=
SITE_ADDRESS=
