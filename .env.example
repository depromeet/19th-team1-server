# 로컬 개발용 환경변수 예시. 복사해서 .env 를 만들고 값을 채운다.
#   cp .env.example .env
# .env 는 git 에 올리지 않는다. 이 파일에는 이름과 예시 형식만 둔다.
#
# DB_PASSWORD, DB_ROOT_PASSWORD 는 반드시 채운다. 로컬 MySQL 이 처음 뜰 때 이 값으로 계정을 만든다.
#   - 각자 정하는 로컬 전용 값이다. 다른 곳에서 쓰는 비밀번호를 재사용하지 않는다.
#   - #, 공백, 따옴표는 쓰지 않는다 (Spring 과 Docker 가 다르게 해석한다).
#   - 나중에 바꾸려면 docker compose down -v 로 데이터를 지우고 다시 띄운다.

DB_NAME=team1
DB_USERNAME=team1
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_URL=jdbc:mysql://localhost:3306/team1
